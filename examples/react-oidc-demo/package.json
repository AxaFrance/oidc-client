{
  "name": "react-oidc-demo",
  "version": "6.24.1",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "OpenID Connect & OAuth authentication using react",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxaGuilDEv/react-oidc.git"
  },
  "scripts": {
    "start": "pnpm prestart && pnpm vite",
    "prestart": "node ./node_modules/@axa-fr/react-oidc/bin/copy-service-worker-files.mjs public",
    "build": "vite build",
    "serve": "vite preview",
    "clean": "rimraf dist",
    "postinstall": "node ./node_modules/@axa-fr/react-oidc/bin/copy-service-worker-files.mjs public"
  },
  "dependencies": {
    "@axa-fr/react-oidc": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "bootstrap": "^5.3.8",
    "copyfiles": "2.4.1",
    "cross-env": "^10.1.0",
    "jsdom": "30.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.0",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
